{
  "tools": [
    {
      "annotations": {
        "destructiveHint": true
      },
      "description": "Create, update, or delete backlog items: entries[] (id present = update, else create) or delete_ids[]. On update, notes replaces; set append_notes=true to append instead (update-only). Reads live under get/search domain=backlog.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "delete_ids": {
            "description": "Item IDs to delete",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "entries": {
            "description": "Items to create/update: {id?}, project, priority, title, description?, notes?, append_notes?, component?, epic?, status?, edges?[{label,target}] (label: blocks|relates|explains, target: item id). description max 500 chars; put narrative in notes. epic may be \"$N\": the item created/updated by entries[N] earlier in this same write, so a child can reference its not-yet-created epic parent",
            "items": {
              "additionalProperties": false,
              "properties": {
                "append_notes": {
                  "description": "Append notes to the existing value instead of replacing (update-only; ignored on create)",
                  "type": "boolean"
                },
                "component": {
                  "description": "Single-valued component tag",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "description": {
                  "description": "Max 500 chars; put narrative in notes",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "edges": {
                  "description": "Inline edges to create from this item: [{label,target}], label: blocks|relates|explains, target: item id",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "target": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                },
                "epic": {
                  "description": "Epic backlog item id, single-valued; may be \"$N\", a back-reference to entries[N] earlier in this same write",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "id": {
                  "description": "Item id to update in place; omit to create",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "notes": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "priority": {
                  "description": "P0-P6",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "project": {
                  "description": "Project name (create only)",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "status": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "title": {
                  "type": [
                    "null",
                    "string"
                  ]
                }
              },
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          }
        },
        "type": "object"
      },
      "name": "backlog"
    },
    {
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Fetch entries by ID or filters (required domain: kb|backlog|roadmap). ids[] returns exact matches; omit ids for a filtered list.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "by": {
            "description": "Grouping axis: \"component\" (default) or \"epic\"; the other axis renders as an inline chip (roadmap get format=md|html only)",
            "type": "string"
          },
          "categories": {
            "description": "Filter by categories (kb only)",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "component": {
            "description": "Component tag filter (backlog: subproject/plugin; roadmap: structural grouping axis, single-valued)",
            "type": "string"
          },
          "domain": {
            "description": "Required: \"kb\", \"backlog\", or \"roadmap\"",
            "type": "string"
          },
          "epic": {
            "description": "Epic backlog item id filter — that epic's children (backlog, roadmap; single-valued — an epic IS a backlog item, see the EPIC: convention)",
            "type": "string"
          },
          "epics_only": {
            "description": "List only epic items, EPIC:-titled (backlog only); takes precedence over epic",
            "type": "boolean"
          },
          "format": {
            "description": "structured, md, or html, default structured (roadmap only)",
            "type": "string"
          },
          "ids": {
            "description": "IDs to fetch (kb: document IDs, backlog: item IDs)",
            "items": true,
            "type": [
              "null",
              "array"
            ]
          },
          "limit": {
            "description": "Limit, default 10, max 500",
            "type": "integer"
          },
          "priority_max": {
            "description": "Max priority P0-P6 (backlog only)",
            "type": "string"
          },
          "priority_min": {
            "description": "Min priority P0-P6 (backlog only)",
            "type": "string"
          },
          "projects": {
            "description": "Filter by project names",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "query": {
            "description": "Full-text search (kb only)",
            "type": "string"
          },
          "since": {
            "description": "Created-time window for backlog items: a duration (24h, 7d), a date (2006-01-02), or an RFC3339 timestamp (backlog only)",
            "type": "string"
          },
          "sort": {
            "description": "\"created\" sorts backlog items newest-first (backlog only)",
            "type": "string"
          },
          "status": {
            "description": "open or done (backlog only)",
            "type": "string"
          },
          "tags": {
            "description": "Filter by tags, all match (kb only)",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "types": {
            "description": "Filter by types (kb only)",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "verbose": {
            "description": "Include notes on ids[] fetch only, default false; filter/list results are always compact regardless",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "get"
    },
    {
      "annotations": {
        "idempotentHint": true
      },
      "description": "Create or update knowledge entries via entries[]: id present = update that doc in place (partial, e.g. retitle without creating a duplicate), else upsert by type+project+category+title. content supports [[Title]] autolinks (an item id or a same-project KB title) creating explains edges. On update, notes replaces; set append_notes=true to append instead (update-only). Reads live under get/search domain=kb.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "entries": {
            "description": "Documents to create/update: {id?}, type, project, category?, title, content, notes?, append_notes?, tags?, metadata?. content max 500 chars; put narrative in notes",
            "items": {
              "additionalProperties": false,
              "properties": {
                "append_notes": {
                  "description": "Append notes to the existing value instead of replacing (update-only; ignored on create)",
                  "type": "boolean"
                },
                "category": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "content": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "id": {
                  "description": "Document id (integer or numeric string) to update in place; omit to create/upsert by type+project+category+title"
                },
                "metadata": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": [
                    "null",
                    "object"
                  ]
                },
                "notes": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "project": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "tags": {
                  "items": {
                    "type": "string"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                },
                "title": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "type": {
                  "type": [
                    "null",
                    "string"
                  ]
                }
              },
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          }
        },
        "type": "object"
      },
      "name": "kb"
    },
    {
      "annotations": {
        "destructiveHint": true
      },
      "description": "Mutate the per-project roadmap singleton (now/next/deferred/parked/dropped/done sections) via op=add|update|move|reorder|done|remove. Items carry two single-valued grouping axes: component (structural) and epic (optional; an epic IS a backlog item). Reads live under get/search domain=roadmap.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "blocked_by": {
            "description": "Cross-project blockers: {project,ref,note} (add/update)",
            "items": {
              "additionalProperties": false,
              "properties": {
                "note": {
                  "description": "Optional note",
                  "type": "string"
                },
                "project": {
                  "description": "Blocking project name",
                  "type": "string"
                },
                "ref": {
                  "description": "Blocking item/ticket ref",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "body": {
            "description": "Item body (add/update)",
            "type": [
              "null",
              "string"
            ]
          },
          "component": {
            "description": "Component tag, single-valued (add/update)",
            "type": [
              "null",
              "string"
            ]
          },
          "epic": {
            "description": "Epic backlog item id, single-valued (add/update)",
            "type": [
              "null",
              "string"
            ]
          },
          "id": {
            "description": "Item ID (update/move/reorder/done/remove)",
            "type": [
              "null",
              "integer"
            ]
          },
          "kb": {
            "description": "Related KB doc IDs (add/update)",
            "items": {
              "type": "integer"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "op": {
            "description": "Required: \"add\", \"update\", \"move\", \"reorder\", \"done\", or \"remove\"",
            "type": "string"
          },
          "position": {
            "description": "Sort position within the section (add/move/reorder; required for reorder)",
            "type": [
              "null",
              "number"
            ]
          },
          "project": {
            "description": "Project name (roadmap singleton)",
            "type": "string"
          },
          "resume_trigger": {
            "description": "Resume trigger (add/update)",
            "type": [
              "null",
              "string"
            ]
          },
          "section": {
            "description": "now|next|deferred|parked|dropped|done (add only)",
            "type": "string"
          },
          "ticket": {
            "description": "Ticket refs (add/update)",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "title": {
            "description": "Item title (add/update)",
            "type": [
              "null",
              "string"
            ]
          },
          "to": {
            "description": "now|next|deferred|parked|dropped|done (move only)",
            "type": "string"
          },
          "why": {
            "description": "Why parked (add/update)",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "type": "object"
      },
      "name": "roadmap"
    },
