{
  "tools": [
    {
      "annotations": {
        "destructiveHint": true
      },
      "description": "Create, update, or delete backlog items: entries[] (id present = update, else create) or delete_ids[]. Reads live under get/search domain=backlog.",
      "inputSchema": {
        "properties": {
          "delete_ids": {
            "description": "Item IDs to delete",
            "type": "array"
          },
          "entries": {
            "description": "Items to create/update: {id?}, project, priority, title, description?, notes?, component?, status?",
            "type": "array"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "backlog"
    },
    {
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Fetch entries by ID or filters (required domain: kb|backlog). ids[] returns exact matches; omit ids for a filtered list.",
      "inputSchema": {
        "properties": {
          "categories": {
            "description": "Filter by categories (kb only)",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "component": {
            "description": "Component tag (subproject/plugin) filter (backlog only)",
            "type": "string"
          },
          "domain": {
            "description": "Required: \"kb\", \"backlog\", or \"roadmap\"",
            "type": "string"
          },
          "format": {
            "description": "structured or md, default structured (roadmap only)",
            "type": "string"
          },
          "ids": {
            "description": "IDs to fetch (kb: document IDs, backlog: item IDs)",
            "type": "array"
          },
          "limit": {
            "description": "Limit, default 10, max 500",
            "type": "number"
          },
          "priority_max": {
            "description": "Max priority P0-P6 (backlog only)",
            "type": "string"
          },
          "priority_min": {
            "description": "Min priority P0-P6 (backlog only)",
            "type": "string"
          },
          "projects": {
            "description": "Filter by project names",
            "type": "array"
          },
          "query": {
            "description": "Full-text search (kb only)",
            "type": "string"
          },
          "status": {
            "description": "open or done (backlog only)",
            "type": "string"
          },
          "tags": {
            "description": "Filter by tags, all match (kb only)",
            "type": "array"
          },
          "types": {
            "description": "Filter by types (kb only)",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "verbose": {
            "description": "Include notes (default: false)",
            "type": "boolean"
          }
        },
        "required": [
          "domain"
        ],
        "type": "object"
      },
      "name": "get"
    },
    {
      "annotations": {
        "idempotentHint": true
      },
      "description": "Create or update knowledge entries via entries[], upserting by type+project+category+title. Reads live under get/search domain=kb.",
      "inputSchema": {
        "properties": {
          "entries": {
            "description": "Documents to upsert",
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "type": "object"
      },
      "name": "kb"
    },
    {
      "annotations": {
        "destructiveHint": true
      },
      "description": "Mutate the per-project roadmap singleton (now/next/parked/done lanes) via op=add|update|move|done|remove. Reads live under get/search domain=roadmap.",
      "inputSchema": {
        "properties": {
          "blocked_by": {
            "description": "Cross-project blockers: {project,ref,note} (add/update)",
            "type": "array"
          },
          "body": {
            "description": "Item body (add/update)",
            "type": "string"
          },
          "component": {
            "description": "Component tag (add/update)",
            "type": "string"
          },
          "id": {
            "description": "Item ID (update/move/done/remove)",
            "type": "number"
          },
          "kb": {
            "description": "Related KB doc IDs (add/update)",
            "type": "array"
          },
          "op": {
            "description": "Required: \"add\", \"update\", \"move\", \"done\", or \"remove\"",
            "type": "string"
          },
          "project": {
            "description": "Project name (roadmap singleton)",
            "type": "string"
          },
          "resume_trigger": {
            "description": "Resume trigger (add/update)",
            "type": "string"
          },
          "section": {
            "description": "now|next|parked|done (add only)",
            "type": "string"
          },
          "ticket": {
            "description": "Ticket refs (add/update)",
            "type": "array"
          },
          "title": {
            "description": "Item title (add/update)",
            "type": "string"
          },
          "to": {
            "description": "now|next|parked|done (move only)",
            "type": "string"
          },
          "why": {
            "description": "Why parked (add/update)",
            "type": "string"
          }
        },
        "required": [
          "op",
          "project"
        ],
        "type": "object"
      },
      "name": "roadmap"
    },
    {
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Full-text search over entries (required domain: kb|backlog). domain=kb supports query or a batched queries[]; domain=backlog takes a single query over title/description/notes.",
      "inputSchema": {
        "properties": {
          "categories": {
            "description": "Filter by categories (kb only)",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "component": {
            "description": "Component tag (subproject/plugin) filter (backlog only)",
            "type": "string"
          },
          "domain": {
            "description": "Required: \"kb\", \"backlog\", or \"roadmap\"",
            "type": "string"
          },
          "limit": {
            "description": "Limit, default 10, max 500",
            "type": "number"
          },
          "priority_max": {
            "description": "Max priority P0-P6 (backlog only)",
            "type": "string"
          },
          "priority_min": {
            "description": "Min priority P0-P6 (backlog only)",
            "type": "string"
          },
          "projects": {
            "description": "Filter by project names",
            "type": "array"
          },
          "queries": {
            "description": "Batch queries sharing filters, kb only; response is positional [[...], [...]]",
            "type": "array"
          },
          "query": {
            "description": "Single query",
            "type": "string"
          },
          "status": {
            "description": "open or done (backlog only)",
            "type": "string"
          },
          "types": {
            "description": "Filter by types (kb only)",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "domain"
        ],
        "type": "object"
      },
      "name": "search"
    }
  ]
}