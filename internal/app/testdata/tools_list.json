{
  "tools": [
    {
      "annotations": {
        "destructiveHint": true
      },
      "description": "Create/update/delete backlog items via entries[] (id = update, else create) or delete_ids[]. Read via query domain=backlog.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "delete_ids": {
            "description": "Item IDs to delete",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "entries": {
            "description": "Backlog items to create (id absent) or update in place (id present).",
            "items": {
              "additionalProperties": false,
              "properties": {
                "append_notes": {
                  "description": "Append notes to the existing value instead of replacing (update-only; ignored on create)",
                  "type": "boolean"
                },
                "component": {
                  "description": "Single-valued component tag",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "description": {
                  "description": "Max 500 chars; put narrative in notes",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "edges": {
                  "description": "Inline edges to create from this item: [{label,target}], label: blocks|relates|explains, target: item id",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "target": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                },
                "epic": {
                  "description": "Epic backlog item id, single-valued; may be \"$N\", a back-reference to entries[N] earlier in this same write",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "id": {
                  "description": "Item id to update in place; omit to create",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "notes": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "priority": {
                  "description": "P0-P6",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "project": {
                  "description": "Project name (create only)",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "status": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "title": {
                  "type": [
                    "null",
                    "string"
                  ]
                }
              },
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          }
        },
        "type": "object"
      },
      "name": "backlog"
    },
    {
      "annotations": {
        "idempotentHint": true
      },
      "description": "Create/update knowledge entries via entries[]: with id updates that doc in place (partial), else upserts by type+project+category+title. content [[Title]] autolinks create explains edges. Read via query domain=kb.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "entries": {
            "description": "KB docs to create (id absent) or update in place (id present). content max 500 chars; put narrative in notes",
            "items": {
              "additionalProperties": false,
              "properties": {
                "append_notes": {
                  "description": "Append notes to the existing value instead of replacing (update-only; ignored on create)",
                  "type": "boolean"
                },
                "category": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "content": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "id": {
                  "description": "Document id (integer or numeric string) to update in place; omit to create/upsert by type+project+category+title"
                },
                "metadata": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": [
                    "null",
                    "object"
                  ]
                },
                "notes": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "project": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "tags": {
                  "items": {
                    "type": "string"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                },
                "title": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "type": {
                  "type": [
                    "null",
                    "string"
                  ]
                }
              },
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          }
        },
        "type": "object"
      },
      "name": "kb"
    },
    {
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Read entries (required domain: kb|backlog|roadmap). ids[] = exact fetch; query or queries[] (kb batch) = full-text search; else a filtered list. verbose=true adds notes/edges (ids[] only). roadmap: format=md|html\u0026by=component|epic.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "by": {
            "description": "Grouping axis: component (default) or epic (roadmap md/html only); other axis shown inline",
            "type": "string"
          },
          "categories": {
            "description": "Filter by categories (kb only)",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "component": {
            "description": "Component tag filter (backlog subproject/plugin; roadmap grouping axis)",
            "type": "string"
          },
          "domain": {
            "description": "Required: \"kb\", \"backlog\", or \"roadmap\"",
            "type": "string"
          },
          "epic": {
            "description": "Epic item id filter — its children (backlog/roadmap)",
            "type": "string"
          },
          "epics_only": {
            "description": "List only epics (backlog only); overrides epic",
            "type": "boolean"
          },
          "format": {
            "description": "structured, md, or html, default structured (roadmap only)",
            "type": "string"
          },
          "ids": {
            "description": "IDs to fetch (kb: document IDs, backlog: item IDs); exact match, skips search/filter mode",
            "items": true,
            "type": [
              "null",
              "array"
            ]
          },
          "limit": {
            "description": "Limit, default 10, max 500",
            "type": "integer"
          },
          "priority_max": {
            "description": "Max priority P0-P6 (backlog only)",
            "type": "string"
          },
          "priority_min": {
            "description": "Min priority P0-P6 (backlog only)",
            "type": "string"
          },
          "projects": {
            "description": "Filter by project names",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "queries": {
            "description": "Batch full-text search sharing filters, kb only; response is positional [[...], [...]]",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "query": {
            "description": "Full-text search (multi-term = AND, falls back to OR once if AND matches nothing); present -\u003e search mode (kb/backlog/roadmap)",
            "type": "string"
          },
          "since": {
            "description": "Created-at cutoff (backlog only): duration (24h, 7d), date (2006-01-02), or RFC3339",
            "type": "string"
          },
          "sort": {
            "description": "\"created\" sorts backlog items newest-first (backlog only)",
            "type": "string"
          },
          "status": {
            "description": "open or done (backlog only)",
            "type": "string"
          },
          "tags": {
            "description": "Filter by tags, all match (kb only; combines with query)",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "types": {
            "description": "Filter by types (kb only)",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "verbose": {
            "description": "Include notes (ids[] fetch only), default false",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "query"
    },
    {
      "annotations": {
        "destructiveHint": true
      },
      "description": "Mutate the per-project roadmap singleton (now/next/deferred/parked/dropped/done) via op=add|update|move|reorder|done|remove. Items group by component and epic (both single-valued). Read via query domain=roadmap.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "blocked_by": {
            "description": "Cross-project blockers: {project,ref,note} (add/update)",
            "items": {
              "additionalProperties": false,
              "properties": {
                "note": {
                  "description": "Optional note",
                  "type": "string"
                },
                "project": {
                  "description": "Blocking project name",
                  "type": "string"
                },
                "ref": {
                  "description": "Blocking item/ticket ref",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "body": {
            "description": "Item body (add/update)",
            "type": [
              "null",
              "string"
            ]
          },
          "component": {
            "description": "Component tag, single-valued (add/update)",
            "type": [
              "null",
              "string"
            ]
          },
          "epic": {
            "description": "Epic backlog item id, single-valued (add/update)",
            "type": [
              "null",
              "string"
            ]
          },
          "id": {
            "description": "Item ID (update/move/reorder/done/remove)",
            "type": [
              "null",
              "integer"
            ]
          },
          "kb": {
            "description": "Related KB doc IDs (add/update)",
            "items": {
              "type": "integer"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "op": {
            "description": "Required: \"add\", \"update\", \"move\", \"reorder\", \"done\", or \"remove\"",
            "type": "string"
          },
          "position": {
            "description": "Sort position within the section (add/move/reorder; required for reorder)",
            "type": [
              "null",
              "number"
            ]
          },
          "project": {
            "description": "Project name (roadmap singleton)",
            "type": "string"
          },
          "resume_trigger": {
            "description": "Resume trigger (add/update)",
            "type": [
              "null",
              "string"
            ]
          },
          "section": {
            "description": "now|next|deferred|parked|dropped|done (add only)",
            "type": "string"
          },
          "ticket": {
            "description": "Ticket refs (add/update)",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "title": {
            "description": "Item title (add/update)",
            "type": [
              "null",
              "string"
            ]
          },
          "to": {
            "description": "now|next|deferred|parked|dropped|done (move only)",
            "type": "string"
          },
          "why": {
            "description": "Why parked (add/update)",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "type": "object"
      },
      "name": "roadmap"
    }
  ]
}