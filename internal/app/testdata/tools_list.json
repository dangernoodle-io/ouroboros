{
  "tools": [
    {
      "annotations": {
        "destructiveHint": true
      },
      "description": "Create, update, or delete backlog items: entries[] (id present = update, else create) or delete_ids[]. Reads live under get/search domain=backlog.",
      "inputSchema": {
        "properties": {
          "delete_ids": {
            "description": "Item IDs to delete",
            "type": "array"
          },
          "entries": {
            "description": "Items to create/update: {id?}, project, priority, title, description?, notes?, component?, epic?, status?, edges?[{label,target}] (label: blocks|relates|explains, target: item id)",
            "type": "array"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "backlog"
    },
    {
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Fetch entries by ID or filters (required domain: kb|backlog). ids[] returns exact matches; omit ids for a filtered list.",
      "inputSchema": {
        "properties": {
          "by": {
            "description": "Grouping axis: \"component\" (default) or \"epic\"; the other axis renders as an inline chip (roadmap get format=md|html only)",
            "type": "string"
          },
          "categories": {
            "description": "Filter by categories (kb only)",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "component": {
            "description": "Component tag filter (backlog: subproject/plugin; roadmap: structural grouping axis, single-valued)",
            "type": "string"
          },
          "domain": {
            "description": "Required: \"kb\", \"backlog\", or \"roadmap\"",
            "type": "string"
          },
          "epic": {
            "description": "Epic backlog item id filter (roadmap only; single-valued — an epic IS a backlog item, see the EPIC: convention)",
            "type": "string"
          },
          "format": {
            "description": "structured, md, or html, default structured (roadmap only)",
            "type": "string"
          },
          "ids": {
            "description": "IDs to fetch (kb: document IDs, backlog: item IDs)",
            "type": "array"
          },
          "limit": {
            "description": "Limit, default 10, max 500",
            "type": "number"
          },
          "priority_max": {
            "description": "Max priority P0-P6 (backlog only)",
            "type": "string"
          },
          "priority_min": {
            "description": "Min priority P0-P6 (backlog only)",
            "type": "string"
          },
          "projects": {
            "description": "Filter by project names",
            "type": "array"
          },
          "query": {
            "description": "Full-text search (kb only)",
            "type": "string"
          },
          "status": {
            "description": "open or done (backlog only)",
            "type": "string"
          },
          "tags": {
            "description": "Filter by tags, all match (kb only)",
            "type": "array"
          },
          "types": {
            "description": "Filter by types (kb only)",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "verbose": {
            "description": "Include notes (default: false)",
            "type": "boolean"
          }
        },
        "required": [
          "domain"
        ],
        "type": "object"
      },
      "name": "get"
    },
    {
      "annotations": {
        "idempotentHint": true
      },
      "description": "Create or update knowledge entries via entries[]: id present = update that doc in place (partial, e.g. retitle without creating a duplicate), else upsert by type+project+category+title. content supports [[Title]] autolinks (an item id or a same-project KB title) creating explains edges. Reads live under get/search domain=kb.",
      "inputSchema": {
        "properties": {
          "entries": {
            "description": "Documents to create/update: {id?}, type, project, category?, title, content, notes?, tags?, metadata?",
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "type": "object"
      },
      "name": "kb"
    },
    {
      "annotations": {
        "destructiveHint": true
      },
      "description": "Mutate the per-project roadmap singleton (now/next/deferred/parked/dropped/done sections) via op=add|update|move|reorder|done|remove. Items carry two single-valued grouping axes: component (structural) and epic (optional; an epic IS a backlog item). Reads live under get/search domain=roadmap.",
      "inputSchema": {
        "properties": {
          "blocked_by": {
            "description": "Cross-project blockers: {project,ref,note} (add/update)",
            "type": "array"
          },
          "body": {
            "description": "Item body (add/update)",
            "type": "string"
          },
          "component": {
            "description": "Component tag, single-valued (add/update)",
            "type": "string"
          },
          "epic": {
            "description": "Epic backlog item id, single-valued (add/update)",
            "type": "string"
          },
          "id": {
            "description": "Item ID (update/move/reorder/done/remove)",
            "type": "number"
          },
          "kb": {
            "description": "Related KB doc IDs (add/update)",
            "type": "array"
          },
          "op": {
            "description": "Required: \"add\", \"update\", \"move\", \"reorder\", \"done\", or \"remove\"",
            "type": "string"
          },
          "position": {
            "description": "Sort position within the section (add/move/reorder; required for reorder)",
            "type": "number"
          },
          "project": {
            "description": "Project name (roadmap singleton)",
            "type": "string"
          },
          "resume_trigger": {
            "description": "Resume trigger (add/update)",
            "type": "string"
          },
          "section": {
            "description": "now|next|deferred|parked|dropped|done (add only)",
            "type": "string"
          },
          "ticket": {
            "description": "Ticket refs (add/update)",
            "type": "array"
          },
          "title": {
            "description": "Item title (add/update)",
            "type": "string"
          },
          "to": {
            "description": "now|next|deferred|parked|dropped|done (move only)",
            "type": "string"
          },
          "why": {
            "description": "Why parked (add/update)",
            "type": "string"
          }
        },
        "required": [
          "op",
          "project"
        ],
        "type": "object"
      },
      "name": "roadmap"
    },
    {
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Full-text search over entries (required domain: kb|backlog). domain=kb supports query or a batched queries[]; domain=backlog takes a single query over title/description/notes.",
      "inputSchema": {
        "properties": {
          "categories": {
            "description": "Filter by categories (kb only)",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "component": {
            "description": "Component tag filter (backlog: subproject/plugin; roadmap: structural grouping axis, single-valued)",
            "type": "string"
          },
          "domain": {
            "description": "Required: \"kb\", \"backlog\", or \"roadmap\"",
            "type": "string"
          },
          "limit": {
            "description": "Limit, default 10, max 500",
            "type": "number"
          },
          "priority_max": {
            "description": "Max priority P0-P6 (backlog only)",
            "type": "string"
          },
          "priority_min": {
            "description": "Min priority P0-P6 (backlog only)",
            "type": "string"
          },
          "projects": {
            "description": "Filter by project names",
            "type": "array"
          },
          "queries": {
            "description": "Batch queries sharing filters, kb only; response is positional [[...], [...]]",
            "type": "array"
          },
          "query": {
            "description": "Single query",
            "type": "string"
          },
          "status": {
            "description": "open or done (backlog only)",
            "type": "string"
          },
          "types": {
            "description": "Filter by types (kb only)",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "domain"
        ],
        "type": "object"
      },
      "name": "search"
    }
  ]
}