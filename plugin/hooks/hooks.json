{
  "hooks": {
    "SessionStart": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap.js",
        "timeout": 30
      }]
    }],
    "PostToolUse": [{
      "matcher": "tool == \"Bash\"",
      "hooks": [{
        "type": "command",
        "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/post-commit-nudge.js",
        "timeout": 3
      }],
      "description": "Nudge to /persist after git commits"
    }, {
      "matcher": "tool == \"Edit\" || tool == \"Write\" || tool == \"MultiEdit\" || tool == \"NotebookEdit\"",
      "hooks": [{
        "type": "command",
        "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/post-edit-check.js",
        "timeout": 3
      }],
      "description": "Check KB for entries referencing edited files"
    }],
    "SubagentStop": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_DATA}/bin/ouroboros claude hooks subagent-stop",
        "timeout": 6
      }],
      "description": "Persist explicit kb blocks from a subagent's final message"
    }],
    "Stop": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_DATA}/bin/ouroboros claude hooks stop",
        "timeout": 6
      }],
      "description": "Auto-persist or nudge main-context KB blocks/decisions when a turn ends"
    }],
    "SubagentStart": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_DATA}/bin/ouroboros claude hooks subagent-start",
        "timeout": 5
      }],
      "description": "Inject KB context into subagent at startup"
    }],
    "UserPromptSubmit": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_DATA}/bin/ouroboros claude hooks user-prompt-submit",
        "timeout": 5
      }],
      "description": "Inject KB context for current project"
    }],
    "PreCompact": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/pre-compact.js",
        "timeout": 10
      }],
      "description": "Persistence safety net: block compaction if unpersisted decisions detected"
    }]
  }
}
